# Copy to .env and fill in. Never commit .env. Names and defaults: src/config.ts.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stellar_pay_analytics

# Stellar Pay API origin, without /v1 (the aggregator reads only from the API, never the chain).
# From inside docker compose on Docker Desktop, use http://host.docker.internal:3000
API_BASE_URL=http://localhost:3000
# Comma-separated secret keys with the `payments:read` scope, one per merchant to ingest.
API_KEYS=
# Bearer token required on /stats/*. At least 32 characters, e.g. `openssl rand -base64 48`.
STATS_BEARER_TOKEN=

# Optional (defaults shown)
# INGEST_INTERVAL_MS=60000
# MIGRATE_ON_START=true
