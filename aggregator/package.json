{
  "name": "stellar-pay-analytics-aggregator",
  "version": "0.1.0",
  "private": true,
  "description": "Ingests payments from the Stellar Pay API and serves aggregate metrics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed:synthetic": "tsx scripts/seed-synthetic.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "stellar-pay-sdk": "0.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.26.2",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.2",
      "qs": "6.16.1",
      "body-parser": "1.20.9"
    }
  }
}
