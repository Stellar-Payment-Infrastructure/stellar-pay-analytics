# Read by the Vite dev server only (vite.config.ts). It proxies /api to the
# aggregator and adds the bearer token server-side, so the token never ships
# in the browser bundle. Export these in your shell before `pnpm dev`.
AGGREGATOR_URL=http://localhost:4000
# Same value as the aggregator's STATS_BEARER_TOKEN.
ANALYTICS_TOKEN=
