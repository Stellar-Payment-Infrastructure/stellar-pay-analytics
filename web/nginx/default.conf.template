# Rendered by the nginx image's envsubst step (AGGREGATOR_URL, ANALYTICS_TOKEN).
# The stats bearer token is added here, server-side; it is never in the JS bundle.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${AGGREGATOR_URL}/;
        proxy_set_header Authorization "Bearer ${ANALYTICS_TOKEN}";
        proxy_set_header Host $proxy_host;
    }
}
